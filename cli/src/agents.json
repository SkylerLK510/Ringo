[
  {
    "name": "codex",
    "company": "OpenAI Codex CLI",
    "adapter": "codex",
    "install": "npm install -g @openai/codex      (or: brew install --cask codex)",
    "login": ["login"],
    "read": true,
    "npm": "@openai/codex",
    "installer": {
      "unix": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
      "windows": "powershell -ExecutionPolicy ByPass -c \"irm https://chatgpt.com/codex/install.ps1 | iex\""
    }
  },
  {
    "name": "claude",
    "company": "Anthropic Claude Code",
    "adapter": "claude",
    "install": "curl -fsSL https://claude.ai/install.sh | bash      (Windows: irm https://claude.ai/install.ps1 | iex)",
    "login": ["auth", "login"],
    "read": true,
    "npm": "@anthropic-ai/claude-code",
    "self_update": "claude update"
  },
  {
    "name": "grok",
    "company": "xAI Grok Build",
    "adapter": "plain",
    "install": "curl -fsSL https://x.ai/cli/install.sh | bash      (Windows: irm https://x.ai/cli/install.ps1 | iex)",
    "args": ["-p", "{prompt}", "--output-format", "plain", "--no-auto-update", "--always-approve", "--cwd", "{cwd}"]
  },
  {
    "name": "agy",
    "company": "Google Antigravity CLI",
    "adapter": "agy",
    "install": "curl -fsSL https://antigravity.google/cli/install.sh | bash      (Windows: irm https://antigravity.google/cli/install.ps1 | iex)",
    "read": true
  }
]
